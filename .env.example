# Local vault works without these. Chain writes require your own isolated testnet relays.
FACET_CONTRACT_ID=
FACET_ISSUER_ID=
FACET_ISSUER_KEY=
FACET_VERIFIER_ID=
FACET_VERIFIER_KEY=
FACET_BBS_SECRET=
FACET_REQUEST_SEED=
FACET_RPC_URL=https://test.rpc.fastnear.com
# Keep all secret values in ignored .env.local or encrypted host settings.
# Never put contract/admin full-access keys in the hosted environment.
