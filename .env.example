# Local vault works without these. Chain writes require your own isolated testnet relays.
FACET_CONTRACT_ID=
FACET_ISSUER_ID=
FACET_ISSUER_KEY=
FACET_VERIFIER_ID=
FACET_VERIFIER_KEY=
FACET_BBS_SECRET=
FACET_REQUEST_SEED=
FACET_RPC_URL=https://near-testnet.drpc.org
# Optional persistent TEE storage and scoped agent execution.
FACET_BROKER_ID=
FACET_BROKER_KEY=
FACET_AGENT_ID=
FACET_AGENT_KEY=
# Keep all secret values in ignored .env.local or encrypted host settings.
# Never put contract/admin full-access keys in the hosted environment.
# Issuer, verifier and agent keys are function-call restricted.
# The broker spends only its own dedicated, limited testnet balance on ingress
# storage deposits; it has no contract or OutLayer project admin authority.
